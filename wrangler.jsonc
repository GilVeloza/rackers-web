{
  // La web de rackers.app: ficheros, más un Worker de nada para las entradas
  // sin idioma y los vídeos.
  //
  // La construye `python3 build.py` en `publico/` (51 idiomas, cada uno con
  // su portada y sus tres páginas legales) y Cloudflare los sirve tal cual.
  // Pasan antes por `worker.js` tres cosas: las entradas sin idioma, que mandan
  // a cada uno al suyo según su navegador y su país (ver `idioma.js`), los
  // vídeos, que contesta a trozos porque si no el iPhone no reproduce ninguno
  // (ver `rangos.js`), y las invitaciones a torneos de /t/{código}, con el
  // archivo que hace que esos enlaces abran la app (ver `torneo.js`).
  //
  // La API es otro Worker, `racqer-api`, y sigue en `racqer.app`: son dos
  // dominios distintos a propósito, así la web lleva el nombre nuevo y los
  // endpoints no se mueven de donde ya estaban.
  //
  // Para publicar, desde la raíz de este repo:
  //   python3 build.py
  //   npx wrangler@4 deploy
  "name": "rackers-web",
  "compatibility_date": "2026-09-01",
  // La cuenta de Cloudflare «racqer-api», la misma que la API.
  "account_id": "5cac3e3413c9038fe20f6029f1af2f90",
  // Nada de URL pública de pruebas: se ve en el dominio y ya.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "rackers.app",
      "custom_domain": true
    }
  ],
  "main": "worker.js",
  "assets": {
    "directory": "./publico",
    "binding": "ASSETS",
    // Solo las entradas sin idioma y los vídeos pasan por el Worker. Lo demás
    // lo sirve Cloudflare directamente, sin gastar peticiones del Worker.
    "run_worker_first": ["/", "/privacidad/", "/condiciones/", "/soporte/",
                         "/privacy/", "/terms/", "/support/",
                         "/static/*.mp4", "/static/*.webm", "/static/deportes/*.mp4",
                         "/t/*", "/.well-known/apple-app-site-association"]
  }
}
